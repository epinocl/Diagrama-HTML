# =============================================================================
# .gitignore — AXON CAD / Diagrama-HTML
# =============================================================================

# Dependencias Node.js
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Compilacion y artefactos de distribucion
dist/
build/
out/
.next/
.cache/

# Entornos virtuales y cache de Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
develop-eggs/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Entornos y secretos locales
.env
.env.local
.env.*.local
*.local

# Logs y bases de datos locales temporales
logs/
*.log
*.sqlite
*.sqlite3

# Archivos de configuracion de IDEs y del sistema
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.sublime-project
*.sublime-workspace
.DS_Store
Thumbs.db
ehthumbs.db
[Dd]esktop.ini

# Archivos temporales de agentes de IA y compresion
.claude/
.codex/
.antigravity/
scratch/
tmp/
temp/
*.tmp
*.bak
*.swp
*~

# Carpeta de pruebas locales, bosquejos y paquetes de prueba (ignorado de GitHub)
pruebas/
pruebas_locales/
temp_proyecto_*/
